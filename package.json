{
  "name": "kapelle",
  "version": "0.1.0",
  "type": "module",
  "description": "A minimal Agent Client Protocol client — supervise coding agents from Node",
  "license": "MIT",
  "author": "Yongchuan Liu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EdwardLiuyc/kapelle.git"
  },
  "bin": {
    "kapelle": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node cli.ts",
    "prepack": "rm -rf dist && tsc -p tsconfig.build.json && mkdir -p dist/assets && cp assets/orchestrator.md dist/assets/orchestrator.md",
    "fmt": "biome check --write .",
    "fmt:check": "biome check .",
    "selftest": "node cli.ts \"self test\" --cmd \"node mock-agent.mjs\" --mode auto",
    "check": "if find . -path ./node_modules -prune -o \\( -name '*.ts' -o -name '*.mts' -o -name '*.cts' \\) -print | grep -q .; then tsc --noEmit; else echo 'check: no TypeScript files yet; tsc skipped'; fi",
    "knip": "knip --no-config-hints && knip --production --include files --no-config-hints",
    "test": "node --test --test-timeout=30000",
    "test:harness": "node --test --test-timeout=180000 'integration/*.itest.ts'"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^24.13.3",
    "knip": "^6.34.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "1.1.0",
    "@xterm/headless": "6.0.0",
    "marked": "18.0.12"
  },
  "overrides": {
    "@earendil-works/pi-tui": {
      "marked": "$marked"
    }
  }
}
